# =============================================================================
# Career Copilot   - environment template
# =============================================================================
# Copy this file to `.env` in the repo root and fill in real values.
# NEVER commit `.env` (it holds secrets). This file is safe to commit.
#
# Legend:
#   [browser]    - read by Vite frontend (VITE_* only; never put private keys here)
#   [server]     - FastAPI only; never expose to the browser
#   [optional]   - feature works without it (often with reduced capability)
# =============================================================================

# -----------------------------------------------------------------------------
# App identity & runtime  [server]
# -----------------------------------------------------------------------------
# Human-readable API name shown in health/status responses.
APP_NAME=Career Copilot API
# development | test | production   - APP_ENV=test forces in-memory object storage.
APP_ENV=development
# REST prefix for all product APIs (frontend proxies /api/backend   - this).
API_V1_PREFIX=/api/v1
# Absolute public origin of the FastAPI process (used in links / diagnostics).
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Frontend origins & ports  [server + scripts]
# -----------------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS (with credentials).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: override ports used by `npm run dev` (defaults derived from URLs above).
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# Optional direct browser   - API origin. Local Vite usually uses same-origin proxy instead.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Auth (app JWT)  [server]
# -----------------------------------------------------------------------------
# Long random secret used to sign HS256 access tokens (career_copilot_session cookie
# + Authorization: Bearer). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-a-long-random-local-secret
# Access token lifetime in seconds (default 7 days = 604800).
JWT_TTL_SECONDS=604800

# -----------------------------------------------------------------------------
# Firebase Web App config  [browser   - VITE_* only]
# -----------------------------------------------------------------------------
# From Firebase Console   - Project settings   - Your apps   - Web app.
# These are public client identifiers (still keep them out of git if you prefer).
# Enable Google under Authentication   - Sign-in method first.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Firebase Admin / Cloud Firestore  [server]
# -----------------------------------------------------------------------------
# Must match VITE_FIREBASE_PROJECT_ID for Google sign-in exchange to work.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Firestore database id; leave as (default) unless you created a named DB.
FIREBASE_DATABASE_ID=(default)
# Path to the service-account JSON (never commit this file).
# Absolute or repository-relative, e.g. ./secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
# Optional: Firebase Storage bucket name if you still use Console Storage for other assets.
# Product resume/avatar bytes use Supabase Storage (see SUPABASE_* below).
# FIREBASE_STORAGE_BUCKET=
# When true, verify_id_token also checks token revocation (needs Auth Admin rights).
# Leave false for local dev if Admin SDK lacks Auth lookup permissions.
FIREBASE_CHECK_REVOKED=false
# Allowed clock skew when verifying Firebase ID tokens (0  -60 seconds).
# FIREBASE_CLOCK_SKEW_SECONDS=10

# -----------------------------------------------------------------------------
# Object storage  [server]
# -----------------------------------------------------------------------------
# Product path: Supabase Storage (private bucket). Logical folder prefixes:
DOCUMENT_BUCKET=candidate-documents
AVATAR_BUCKET=candidate-avatars
# Browser downloads: GET /api/v1/files/{bucket}/{path} with JWT ownership checks
# (proxied as /api/files/... in Vite).
#
# Required for real file upload/download outside APP_ENV=test:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=career-copilot-files

# File size limits (bytes) and authenticated file-URL lifetime (seconds).
DOCUMENT_MAX_BYTES=10485760
AVATAR_MAX_BYTES=3145728
# Interview media uploads disabled when 0 (text practice only).
INTERVIEW_MEDIA_MAX_BYTES=0
EXPORT_SIGNED_URL_SECONDS=300

# -----------------------------------------------------------------------------
# LLM providers  [server only   - never VITE_*]
# -----------------------------------------------------------------------------
# Which provider to use when a feature needs a chat/completions model: groq | nvidia
LLM_PROVIDER=groq

# --- Optional OmniRoute sidecar ---
# Set true only after starting the isolated integrations/omniroute service.
# When false, the original Groq/NVIDIA routes are unchanged.
OMNIROUTE_ENABLED=false
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
OMNIROUTE_TIMEOUT_SECONDS=30
OMNIROUTE_MAX_RETRIES=1

# --- NVIDIA (profile fill / some structured extract) ---
# Leave NVIDIA_API_KEY empty when unused. If set, NVIDIA_MODEL is required.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_MAX_RETRIES=1
NVIDIA_MAX_OUTPUT_TOKENS=2048
NVIDIA_TEMPERATURE=0.2
# Prompt pack version string recorded in improvement/metadata.
NVIDIA_PROMPT_VERSION=resume-improvement-v1

# --- Groq (interviews, ATS brief, learning planner, resume parser) ---
# Leave GROQ_API_KEY empty when unused. If set, GROQ_MODEL is required.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=1
GROQ_MAX_OUTPUT_TOKENS=1536
GROQ_TEMPERATURE=0.3

# Shared rate budget: max chat requests per minute per provider process.
LLM_RPM_LIMIT=40
# Second completion to repair invalid JSON. Set false to save RPM when fallbacks exist.
LLM_ALLOW_REPAIR=true

# --- Groq resume section parser (document_parsing LLM path) ---
GROQ_RESUME_PARSER_ENABLED=true
GROQ_RESUME_PARSER_MODEL=openai/gpt-oss-120b
GROQ_RESUME_PARSER_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_RESUME_PARSER_TIMEOUT_SECONDS=60
GROQ_RESUME_PARSER_MAX_RETRIES=1
GROQ_RESUME_PARSER_MAX_INPUT_TOKENS=110000
GROQ_RESUME_PARSER_TEMPERATURE=0

# -----------------------------------------------------------------------------
# External jobs (Adzuna)  [server, optional]
# -----------------------------------------------------------------------------
# https://developer.adzuna.com/   - leave empty to disable POST /jobs/external/sync.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_TIMEOUT_SECONDS=15
# ADZUNA_MAX_DAYS_OLD=30

# -----------------------------------------------------------------------------
# YouTube Data API v3  [server, optional]
# -----------------------------------------------------------------------------
# Learning paths: exact video IDs only from the API (never invented).
# Google Cloud Console   - enable YouTube Data API v3   - create API key.
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_SEARCH_MAX_RESULTS=3
YOUTUBE_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# Resume improvement limits  [server]
# -----------------------------------------------------------------------------
IMPROVEMENT_MAX_SECTIONS=4
IMPROVEMENT_MAX_SOURCE_CHARS=30000
IMPROVEMENT_MAX_JD_CHARS=12000

# -----------------------------------------------------------------------------
# Installer / diagnostics  [scripts, optional]
# -----------------------------------------------------------------------------
# CAREER_COPILOT_PYTHON=C:\Path\To\Python312\python.exe
CAREER_COPILOT_RECREATE_VENV=0
CAREER_COPILOT_AUDIT_BASE=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Fish Audio TTS (mock interview interviewer voice)  [server, optional]
# -----------------------------------------------------------------------------
# https://fish.audio/app/api-keys - when set, mock interview uses natural Fish voice.
# When empty, the browser falls back to speechSynthesis (still works offline).
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
# Free developer tier; use s2.1-pro when on a paid plan.
FISH_AUDIO_MODEL=s2.1-pro-free
# Default public voice (Adrian - steady English narrator). Override with any voice model id.
FISH_AUDIO_REFERENCE_ID=bf322df2096a46f18c579d0baa36f41d
FISH_AUDIO_TIMEOUT_SECONDS=45
