# One repository-wide environment file.
# Copy this file to .env. Keep real credentials only in the ignored .env file.

# Frontend and API
# Optional for a direct browser API origin; local Vite development uses its same-origin proxy by default.
# VITE_API_BASE_URL=http://127.0.0.1:8000
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Firebase Web App config (browser-safe identifiers; never put service-account JSON here).
# Enable Google in Firebase Console -> Authentication -> Sign-in method first.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: override ports used by npm run dev (defaults derived from URLs above)
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
APP_NAME=Career Copilot API
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Firebase / Cloud Firestore (server-only credentials)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_ID=(default)
# Absolute or repository-relative path; never commit this JSON file.
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
# Optional strict session revocation lookup; leave false for local development.
FIREBASE_CHECK_REVOKED=false
LOCAL_STORAGE_DIR=./.data/storage
AUTH_SECRET=replace-with-a-long-random-local-secret
# Access token lifetime in seconds (default 7 days)
JWT_TTL_SECONDS=604800
DOCUMENT_BUCKET=candidate-documents
AVATAR_BUCKET=candidate-avatars
INTERVIEW_BUCKET=interview-media

# File limits and signed local URLs
DOCUMENT_MAX_BYTES=10485760
AVATAR_MAX_BYTES=3145728
INTERVIEW_MEDIA_MAX_BYTES=262144000
EXPORT_SIGNED_URL_SECONDS=300

# Provider selection: groq or nvidia
LLM_PROVIDER=groq

# NVIDIA provider (server-only; leave the key empty when unused)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-3.2
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_MAX_RETRIES=1
NVIDIA_MAX_OUTPUT_TOKENS=2048
NVIDIA_TEMPERATURE=0.2
NVIDIA_PROMPT_VERSION=resume-improvement-v1

# Groq provider (server-only; leave the key empty when unused)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=1
GROQ_MAX_OUTPUT_TOKENS=1536
GROQ_TEMPERATURE=0.3

# Shared LLM rate budget (requests per minute per provider). 40 = ~1.5s spacing.
LLM_RPM_LIMIT=40
# Second completion to fix invalid JSON. Set false to save RPM when fallbacks exist.
LLM_ALLOW_REPAIR=true

# Adzuna external job feed (server-only). Leave empty to disable /jobs/external/sync.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_TIMEOUT_SECONDS=15
# Per-user external sync cooldown is enforced in-process (currently 60s) on POST /jobs/external/sync.

# Groq Resume Parser settings (server-only)
GROQ_RESUME_PARSER_ENABLED=true
GROQ_RESUME_PARSER_MODEL=openai/gpt-oss-120b
GROQ_RESUME_PARSER_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_RESUME_PARSER_TIMEOUT_SECONDS=60
GROQ_RESUME_PARSER_MAX_RETRIES=1
GROQ_RESUME_PARSER_MAX_INPUT_TOKENS=110000
GROQ_RESUME_PARSER_TEMPERATURE=0


# YouTube Data API v3 (server-only) — exact video recommendations for learning paths
# Create a key in Google Cloud Console with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_SEARCH_MAX_RESULTS=3
YOUTUBE_TIMEOUT_SECONDS=20

# Resume improvement limits
IMPROVEMENT_MAX_SECTIONS=4
IMPROVEMENT_MAX_SOURCE_CHARS=30000
IMPROVEMENT_MAX_JD_CHARS=12000

# Optional installer and local API audit controls
# CAREER_COPILOT_PYTHON=C:\Path\To\Python312\python.exe
CAREER_COPILOT_RECREATE_VENV=0
CAREER_COPILOT_AUDIT_BASE=http://127.0.0.1:8000
