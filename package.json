{
  "name": "career-copilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/setup/backend.mjs && node scripts/setup/local-db.mjs",
    "dev": "node scripts/dev/preflight.mjs && node scripts/dev/run.mjs",
    "db:setup": "node scripts/dev/preflight.mjs",
    "dev:frontend": "next dev",
    "dev:backend": "node scripts/dev/backend.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:secrets && npm run check:env && npm run check:frontend",
    "check:env": "node scripts/diagnostics/verify-environment.mjs",
    "check:frontend": "npm run lint && npm run typecheck && npm run build",
    "check:secrets": "node scripts/diagnostics/check-secrets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "lucide-react": "latest",
    "motion": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
