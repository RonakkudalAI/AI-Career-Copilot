{
  "name": "career-copilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/setup-backend.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "next dev",
    "dev:backend": "python -m uvicorn app.main:app --reload --port 8000 --app-dir backend",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:secrets && npm run check:env && npm run check:frontend",
    "check:env": "node scripts/verify-environment.mjs",
    "check:frontend": "npm run lint && npm run typecheck && npm run build",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "lucide-react": "latest",
    "motion": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "supabase": "^2.110.0",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
