{
  "name": "career-copilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup/project.mjs",
    "postinstall": "node scripts/setup/project.mjs",
    "dev": "node scripts/dev/preflight.mjs && node scripts/dev/run.mjs",
    "dev:frontend": "node scripts/dev/frontend.mjs",
    "dev:backend": "node scripts/dev/backend.mjs",
    "firebase:check": "node scripts/dev/preflight.mjs --strict",
    "lint": "node scripts/run-frontend.mjs lint",
    "tsc": "node scripts/run-frontend.mjs typecheck",
    "typecheck": "node scripts/run-frontend.mjs typecheck",
    "typecheck:app": "node scripts/run-frontend.mjs typecheck:app",
    "typecheck:test": "node scripts/run-frontend.mjs typecheck:test",
    "build": "node scripts/run-frontend.mjs build",
    "build:frontend": "node scripts/run-frontend.mjs build",
    "test": "node scripts/run-frontend.mjs test",
    "check:frontend": "node scripts/run-frontend.mjs check:frontend",
    "validate:landing": "node scripts/run-frontend.mjs validate:landing",
    "check:env": "node scripts/diagnostics/verify-environment.mjs",
    "check:secrets": "node scripts/diagnostics/check-secrets.mjs",
    "check:boundaries": "node scripts/verify-boundaries.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
