APP_NAME=Career Copilot API
APP_ENV=production
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
PUBLIC_API_BASE_URL=https://career-copilot-qao5.onrender.com
FRONTEND_ORIGINS=https://career-copilot-neon.vercel.app

FIREBASE_PROJECT_ID=career-copilot5
FIREBASE_DATABASE_ID=career-copilot
FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase-admin.json

SUPABASE_URL=https://yrbnwwyueghgfcesqpvd.supabase.co
SUPABASE_STORAGE_BUCKET=career-copilot-files
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=REPLACE_WITH_ROTATED_SUPABASE_SECRET
SUPABASE_JWKS_URL=https://yrbnwwyueghgfcesqpvd.supabase.co/auth/v1/.well-known/jwks.json
DOCUMENT_BUCKET=candidate-documents
AVATAR_BUCKET=candidate-avatars

DOCUMENT_MAX_BYTES=10485760
AVATAR_MAX_BYTES=3145728
INTERVIEW_MEDIA_MAX_BYTES=262144000
EXPORT_SIGNED_URL_SECONDS=300

LLM_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2
GROQ_MAX_OUTPUT_TOKENS=2048
GROQ_TEMPERATURE=0.4

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_MAX_RETRIES=2
NVIDIA_MAX_OUTPUT_TOKENS=4096
NVIDIA_TEMPERATURE=0.2
NVIDIA_PROMPT_VERSION=resume-improvement-v1

GROQ_RESUME_PARSER_ENABLED=true
GROQ_RESUME_PARSER_MODEL=llama-3.3-70b-versatile
GROQ_RESUME_PARSER_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_RESUME_PARSER_TIMEOUT_SECONDS=60
GROQ_RESUME_PARSER_MAX_RETRIES=2
GROQ_RESUME_PARSER_MAX_INPUT_TOKENS=110000
GROQ_RESUME_PARSER_TEMPERATURE=0

IMPROVEMENT_MAX_SECTIONS=4
IMPROVEMENT_MAX_SOURCE_CHARS=30000
IMPROVEMENT_MAX_JD_CHARS=12000

# Add these in Render's Environment dashboard as secret values.
AUTH_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_ROTATED_SUPABASE_SECRET
GROQ_API_KEY=REPLACE_WITH_ROTATED_GROQ_KEY
NVIDIA_API_KEY=REPLACE_WITH_ROTATED_NVIDIA_KEY
ADZUNA_APP_ID=REPLACE_IF_USED
ADZUNA_APP_KEY=REPLACE_IF_USED
YOUTUBE_API_KEY=REPLACE_IF_USED
FISH_AUDIO_API_KEY=REPLACE_IF_USED
