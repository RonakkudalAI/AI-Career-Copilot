rules_version = '2';

// The application uses the FastAPI server and Firebase Admin SDK as the only
// Firestore data path. Admin SDK calls are authorized by IAM and bypass rules.
// Deny direct browser access so client credentials cannot bypass API ownership.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
