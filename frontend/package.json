{
  "name": "career-copilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "vite --host 127.0.0.1 --port 3000",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:frontend": "npm run lint && npm run typecheck && npm run test && npm run build",
    "validate:landing": "node scripts/validate-landing.mjs",
    "e2e": "playwright test",
    "e2e:landing": "playwright test e2e/landing.spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "class-variance-authority": "^0.7.1",
    "cobe": "^2.0.1",
    "firebase": "^12.17.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
