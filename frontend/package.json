{
  "name": "career-copilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:frontend": "npm run lint && npm run typecheck && npm run test && npm run build",
    "validate:landing": "node scripts/validate-landing.mjs",
    "e2e": "playwright test",
    "e2e:landing": "playwright test e2e/landing.spec.ts"
  },
  "dependencies": {
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "cobe": "^2.0.1",
    "lucide-react": "latest",
    "motion": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "latest",
    "@testing-library/react": "^16.3.2",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "jsdom": "^29.1.1",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "^4.1.10"
  }
