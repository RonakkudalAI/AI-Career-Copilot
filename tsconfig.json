{
  "extends": "./frontend/tsconfig.app.json",
  "compilerOptions": {
    "baseUrl": "./frontend",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./frontend/node_modules/@types"
    ]
  },
  "include": [
    "env.d.ts",
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx"
  ],
  "exclude": [
    "frontend/node_modules",
    "frontend/dist",
    "frontend/src/**/__tests__/**",
    "frontend/src/**/*.test.ts",
    "frontend/src/**/*.test.tsx",
    "frontend/src/**/*.spec.ts",
    "frontend/src/**/*.spec.tsx"
  ]
}